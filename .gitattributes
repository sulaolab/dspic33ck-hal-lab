# Normalize text to LF in the repo, CRLF in the working tree, independent of
# each contributor's core.autocrlf / TortoiseGit settings. `text=auto` is what
# prevents CRLF blobs from being committed; `eol=crlf` only sets checkout EOL
# and matches the Windows / MPLAB X fleet convention.
* text=auto eol=crlf

# Binary assets/outputs (never EOL-converted)
*.png binary
*.jpg binary
*.svg binary
*.hex binary
*.elf binary
*.o   binary
*.a   binary
*.X.a binary
*.bin binary
*.exe binary
*.uf2 binary

# MPLAB X / build-tool-generated files: byte-exact, let the tool be EOL king.
# Must come AFTER the general rule above (last-match-wins). Use -text (NOT
# text eol=crlf) so git and MPLAB don't fight; the whitespace= attribute
# suppresses the git diff --check cr-at-eol warning. Glob paths cover every
# .X project in the repo (main + QTM etc.).
**/nbproject/*.mk                       -text
**/nbproject/Makefile-*                 -text
**/nbproject/configurations.xml         -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
**/nbproject/private/configurations.xml -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
**/nbproject/project.xml                -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Exclude non-public records and maintainer tooling from source archives. The
# explicit recursive patterns also make per-path attribute checks unambiguous.
tools/nora_hal_sync/** export-ignore
.github/**             export-ignore
docs_internal/**       export-ignore
AGENTS.md               export-ignore
tools/check_vendor_source.ps1 export-ignore
CLAUDE.md               export-ignore
.serial-monitor.json    export-ignore

# These helpers are not required to build or use the public source tree.
tools/publish/**        export-ignore
tools/host_check/**     export-ignore
tools/cost_probe/**     export-ignore
buildtools/add_board_ownership_guards.ps1  export-ignore

# Session handovers, cross-repository requests and local publication helpers.
NEXT_*.md export-ignore
REQUEST_*.md export-ignore
tools_local/** export-ignore
docs/ak_nano_pwm_scope_validation_handoff.md export-ignore
tools/pwm_audio_host/README.md export-ignore
